%% cassirerchemistry.sty
%% Self-contained style file for CassirerChemistry.tex
%% (Broggio & Giovanelli, "Cassirer on the History and Philosophy of Chemistry").
%% Consolidates the parts of els.sty, addpackfix/{char,mat,bib,ref,q,com,dat,sec,ano,aut}.sty
%% and addpackspecial/cassirer.sty that the paper actually uses.
%%
%% Usage: \usepackage{cassirerchemistry} is the only package the paper loads.
%% Bibliography: CassirerChemistry.bib (same folder).
%% Compile with pdflatex + biber.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cassirerchemistry}[2026/11/03 Style for CassirerChemistry.tex]

% chemical structure diagrams
\RequirePackage{chemfig}

