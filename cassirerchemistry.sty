\RequirePackage{xparse}

\newcommand{\citep}{\parencite}
\newcommand{\citet}{\textcite}
% Author's (year: page)
\newcommand{\citets}[2][]{\citeauthor{#2}'s (\citeyear{#2}\if\relax\detokenize{#1}\relax\else: #1\fi)}

\DeclareCiteCommand{\citeyear}
    {}
    {\bibhyperref{\printdate}}
    {\multicitedelim}
    {}

\newcommand{\fn}[1]{; fn.~#1}

% volume/document locators (also used inside fields of biblatex.bib)
\NewDocumentCommand\V{m}{Vol.\ #1}
\NewDocumentCommand\VV{m}{Vols.~#1}
\NewDocumentCommand\VD{mm}{Vol.\ #1, Doc.\ #2}
\NewDocumentCommand\VDs{mm}{Vol.\ #1, Docs.\ #2}
\NewDocumentCommand\VP{mm}{Vol.\ #1, #2}
\NewDocumentCommand\VDP{mmm}{Vol.\ #1, Doc.\ #2, #3}
\NewDocumentCommand\SVP{mmm}{Ser.\ #1, Vol.\ #2, #3}
\NewDocumentCommand\D{m}{Doc.\ #1}
\NewDocumentCommand\DD{m}{Docs.\ #1}
\NewDocumentCommand\DP{mm}{Doc.\ #1, #2}

% reprint/publication notes (used inside fields of biblatex.bib)
\newcommand*{\repr}[2]{\autocap{r}epr.~in \cite[#2]{#1}}
\newcommand*{\repras}[2]{\autocap{r}epr.\ as \cite[#2]{#1}}
\newcommand*{\publ}[2]{\autocap{f}irst pub.~in \cite[#2]{#1}}
\newcommand*{\pub}[1]{\autocap{p}ub.\ in #1}
\newcommand*{\postumin}[2]{\autocap{p}ub.~post.\ in \cite[#2]{#1}}
\newcommand*{\postumas}[1]{\autocap{p}ub.~post.\ as \cite{#1}}
\newcommand*{\reprv}[2]{\repr{#1}{\V{#2}}}
\newcommand*{\reprvp}[3]{\repr{#1}{\VP{#2}{#3}}}
\newcommand*{\reprvd}[3]{\repr{#1}{\VD{#2}{#3}}}
\newcommand*{\reprvdp}[4]{\repr{#1}{\VDP{#2}{#3}{#4}}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  Quotations
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\renewcommand*{\mkcitation}[1]{ #1}
\renewcommand{\mkblockquote}[4]{\footnotesize#1#2.\xspace#3#4}
\renewcommand{\mktextquote}[6]{#1#2#4#5#3#6}

% scare quotes
\makeatletter
\newcommand{\scare}[1]{\@ifnextchar.{\enquote*{#1.}\@gobble}{\@ifnextchar,{\enquote*{#1,}\@gobble}{\enquote*{#1}\xspace}}}
\makeatother
\newcommand{\s}{\scare}

% hide the original-language text of a quotation
\newcommand{\hide}[2][]{\unspace}

% direct quotation: \q{text}[citation]
\NewDocumentCommand{\q}{mo}{%
  \IfNoValueTF{#2}
    {\blockquote{#1}}
    {\blockquote[{#2}]{#1}}%
}

% translated quotation with (hidden) original: \qt{translation}{original}[citation]
\makeatletter
\NewDocumentCommand\qt{mmo}{%
\IfNoValueTF {#3}%
   {\@ifnextchar,{\blockquote{#1,}\@gobble}{\blockquote{#1}\hide{#2}}}%
   {\blockquote[{#3}]{#1}\hide{#2}}%
\unspace}
\makeatother

