% Meyerson--Cassirer correspondence, cited after ECN, Vol. 18:
% \letterecnd{From}{To}{day}{month}{year}[doc] (with parentheses: \letterecndp)
\DeclareDocumentCommand\letterecnd{mmmmmoo}{%
{\IfNoValueTF {#6}%
{#1 to #2,  \shortmoam\formatdate{#3}{#4}{#5}}%
{#1 to #2,  \shortmoam\formatdate{#3}{#4}{#5}\footnote{\cite[\VD{18}{#6}]{ECN}}}%
} %
\unspace}

\DeclareDocumentCommand\letterecndp{mmmmmoo}{%
{(\IfNoValueTF {#6}%
{#1 to #2,  \shortmoam\formatdate{#3}{#4}{#5}}%
{#1 to #2,  \shortmoam\formatdate{#3}{#4}{#5}\footnote{\cite[\VD{18}{#6}]{ECN}}}%
} %
\unspace)}

